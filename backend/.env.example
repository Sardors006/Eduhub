# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/eduhub

# JWT Secrets (use strong random strings in production)
ACCESS_TOKEN_SECRET=eduhub_super_secret_access_key_change_in_production_2026
REFRESH_TOKEN_SECRET=eduhub_super_secret_refresh_key_change_in_production_2026

# SMTP Email Configuration (Optional in development — falls back to terminal logging)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EduHub Security <no-reply@eduhub.local>"

# Admin Seed Credentials
ADMIN_EMAIL=admin@eduhub.com
ADMIN_PASSWORD=Admin123!

